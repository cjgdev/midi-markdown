{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$TOOL_ARGS\" == *\".py\"* ]]; then uv run ruff format \"$(echo \"$TOOL_ARGS\" | grep -oP 'file_path[^,}]+'  | cut -d'\"' -f4)\"; fi",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$TOOL_ARGS\" == *\".py\"* ]]; then uv run ruff format \"$(echo \"$TOOL_ARGS\" | grep -oP 'file_path[^,}]+' | cut -d'\"' -f4)\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(source:*)",
      "Bash(pytest:*)",
      "Bash(python3:*)",
      "Bash(ruff format:*)",
      "Bash(uv add:*)",
      "Bash(python -m pytest tests/unit/test_parser.py::TestMMLParser::test_empty_document -v --tb=line)",
      "Bash(python -m pytest tests/unit/test_parser.py -v --tb=line)",
      "Bash(python -m pytest:*)",
      "Bash(python /tmp/debug_parse.py:*)",
      "Bash(midimarkup compile:*)",
      "Bash(python -c:*)",
      "Bash(python /tmp/debug_pressure.py:*)",
      "Bash(python /tmp/debug_note_type.py:*)",
      "Bash(python:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python3:*)",
      "Bash(uv run python:*)",
      "Bash(uv run midimarkup compile:*)",
      "Bash(uv run:*)",
      "Read(//tmp/**)",
      "Bash(cat:*)",
      "Bash(timeout 60 source:*)",
      "Bash(find:*)",
      "Bash(/Users/cgilbert/Work/github.com/cjgdev/midi-markdown/.venv/bin/midimarkup:*)",
      "Bash(/Users/cgilbert/Work/github.com/cjgdev/midi-markdown/.venv/bin/mml:*)",
      "Bash(uv --version:*)",
      "Bash(/Users/cgilbert/Work/github.com/cjgdev/midi-markdown/.venv/bin/pytest --co -q)",
      "Bash(/Users/cgilbert/Work/github.com/cjgdev/midi-markdown/.venv/bin/pytest:*)",
      "Bash(/opt/homebrew/bin/uv run ruff:*)",
      "Bash(/opt/homebrew/bin/uv run midimarkup --version)",
      "Bash(/opt/homebrew/bin/uv run:*)",
      "Bash(for file in quad_cortex_live_set h90_preset_automation helix_song_switching hx_stomp_pedalboard)",
      "Bash(do echo -n \"$file.mml: \")",
      "Bash(done)",
      "Bash(ls:*)",
      "Bash(if [ -f docs/developer-guide/contributing.md ])",
      "Bash(then wc -l docs/developer-guide/contributing.md)",
      "Bash(else echo \"❌ Not found at docs/developer-guide/contributing.md\")",
      "Bash(fi)",
      "Bash(if [ -f CODE_OF_CONDUCT.md ])",
      "Bash(then wc -l CODE_OF_CONDUCT.md)",
      "Bash(else echo \"❌ CODE_OF_CONDUCT.md missing\")",
      "Bash(if [ -d .github/ISSUE_TEMPLATE ])",
      "Bash(then echo 'Issue templates directory found:')",
      "Bash(else echo '❌ .github/ISSUE_TEMPLATE directory not found')",
      "Bash(if [ -f /Users/cgilbert/Work/github.com/cjgdev/midi-markdown/examples/README.md ])",
      "Bash(then)",
      "Bash(else)",
      "Bash(if [ -f .github/PULL_REQUEST_TEMPLATE.md ])",
      "Bash(then wc -l .github/PULL_REQUEST_TEMPLATE.md)",
      "Bash(else echo '❌ PR template missing')",
      "Bash(if [ -d .github/workflows ])",
      "Bash(then echo 'Workflow files found:')",
      "Bash(else echo '❌ .github/workflows directory not found')",
      "Bash(if [ -f .github/ISSUE_TEMPLATE/config.yml ])",
      "Bash(then cat .github/ISSUE_TEMPLATE/config.yml)",
      "Bash(else echo \"No config.yml found\")",
      "Bash(for dir in examples/*/)",
      "Bash(for file in /Users/cgilbert/Work/github.com/cjgdev/midi-markdown/benchmarks/benchmark_*.py)",
      "Bash(chmod:*)",
      "Bash(/tmp/test_examples.sh)"
    ],
    "deny": [],
    "ask": []
  }
}
